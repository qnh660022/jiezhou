# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing secrets (never commit keystore or credentials)
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Widget Preview related
.widget_preview/

# Local debug/build scratch (logs dumped to repo root during troubleshooting)
_analyze_full.txt
_test_full.txt
_buildrunner_full.txt
_build_apk*.err
*.apk
# Windows reserved device name (created by `> nul` redirection; git cannot track it)
nul

# =====================================================================
# 个人/本机构建环境、规划笔记 —— 开源时不外传（仅本项目私有）
# =====================================================================
# 本机工具链/构建脚本（含绝对路径 D:\AI\env、D:\AI\money2.0 等）
/scripts/env.local.ps1
/scripts/setup_env.ps1
/scripts/setup_env_v2.ps1
/scripts/build_apk.ps1
/scripts/_build_apk.ps1
/scripts/_build_bg.ps1
# 与 AI 的规划会话笔记
.zcode/
.trae/

# Flutter 本机工具状态（随机器变化，不入库）
.flutter_tool_state

# 根目录构建调试产物（out.js*，不入库）
/out.js
/out.js.deps
/out.js.map

# drift worker 编译产物（构建时由 dart compile js 重新生成；源码 web/drift_worker.dart 与 sqlite3.wasm 需入库）
web/drift_worker.dart.js
web/drift_worker.dart.js.deps
web/drift_worker.dart.js.map
# 验收报告（可能含个人项目背景，公开前先审阅）
/docs/*.md
